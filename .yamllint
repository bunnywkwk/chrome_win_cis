---
extends: default
ignore: |
  .ansible/
  molecule/
rules:
  braces:
    max-spaces-inside: 1
  brackets:
    max-spaces-inside: 1
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable
  empty-lines:
    max: 1
  indentation:
    spaces: 2
    indent-sequences: consistent
  line-length: disable
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  truthy:
    allowed-values: ["true", "false"]
    check-keys: true
